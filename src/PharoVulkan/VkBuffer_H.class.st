"
Opaque handle for a VkBuffer (non-dispatchable). Wraps the 64-bit driver-allocated identifier for a buffer object. Created by VkBuffer>>allocate; passed to Vulkan commands via getHandle.
"
Class {
	#name : 'VkBuffer_H',
	#superclass : 'VkHandle',
	#category : 'PharoVulkan-Bindings',
	#package : 'PharoVulkan',
	#tag : 'Bindings'
}
