"
Opaque handle for a VkFence (non-dispatchable). Wraps the driver identifier for a CPU-side synchronization primitive signalled when a submitted queue batch completes. Used by VkFenceWrapper.
"
Class {
	#name : 'VkFence_H',
	#superclass : 'VkHandle',
	#category : 'PharoVulkan-Bindings',
	#package : 'PharoVulkan-Bindings'
}
