"
Signalled by PVTypeInferencer when a selector cannot be resolved for the given operand types. Carries the unresolved selector and receiver type for diagnosis.
"
Class {
	#name : 'PVTypeError',
	#superclass : 'Error',
	#category : 'PharoVulkan-SPIRV-Exceptions',
	#package : 'PharoVulkan-SPIRV',
	#tag : 'Exceptions'
}
